#!/usr/bin/env node
'use strict';

// ppjl — pretty-print JSON and JSONL files to stdout.
//
// Each input file is auto-detected: a whole-file JSON document (compact,
// single-line, or pretty-printed) prints as-is; otherwise the file is read
// as JSONL (one JSON value per line). Documents from all inputs are
// combined — a single document prints bare, multiple print as one array.

const fs = require('fs');
const prettier = require('prettier');

const args = process.argv.slice(2);

if (args.length === 0) {
  console.error('Usage: ppjl <file...>  (auto-detects JSON and JSONL)');
  process.exit(1);
}

// Aggregate all JSON documents across inputs: a JSON file contributes its
// single document, a JSONL file contributes one document per line.
const docs = [];
for (const path of args) {
  // Read failures (missing file, permissions) get a readable one-liner
  // instead of a raw stack trace.
  let text;
  try {
    text = fs.readFileSync(path, 'utf8');
  } catch (err) {
    console.error(`ppjl: cannot read ${path}: ${err.message}`);
    process.exit(1);
  }
  const trimmed = text.trim();

  // Whole-file parse first: covers compact, single-line, and pretty-printed
  // multi-line JSON. Failure here is expected for JSONL, so we fall through
  // to line parsing — but the error is kept, since it carries the true
  // position when the file is a broken multi-line JSON document.
  let whole;
  let wholeErr;
  try {
    whole = JSON.parse(trimmed);
  } catch (err) {
    wholeErr = err;
  }

  if (whole !== undefined) {
    docs.push(whole);
    continue;
  }

  // Not a single JSON document → require every non-empty line to be one
  // (JSONL). Fail loudly with file and line context on the first bad line.
  let lineNumber = 0;
  let sawRecord = false;
  for (const line of text.split('\n')) {
    lineNumber++;
    const trimmedLine = line.trim();
    if (trimmedLine === '') continue;
    try {
      docs.push(JSON.parse(trimmedLine));
      sawRecord = true;
    } catch (err) {
      // If earlier lines already parsed, the file is clearly JSONL and this
      // line is the defect. Otherwise a whole-document error is the likelier
      // diagnosis (e.g. broken multi-line JSON) and points at the real spot.
      if (sawRecord) {
        console.error(`ppjl: ${path}:${lineNumber}: ${err.message}`);
        console.error(`ppjl: ${path} is not valid JSONL`);
      } else {
        console.error(`ppjl: ${path}: ${wholeErr.message}`);
        console.error(`ppjl: ${path} is neither valid JSON nor valid JSONL`);
      }
      process.exit(1);
    }
  }

  // Whole-parse failed and no line parsed → empty or whitespace-only file.
  if (!sawRecord) {
    console.error(`ppjl: ${path} contains no JSON values`);
    process.exit(1);
  }
}

// Single document prints bare; multiple documents print as one pretty array.
const output = docs.length === 1 ? docs[0] : docs;

prettier
  .format(JSON.stringify(output), { parser: 'json', printWidth: 100 })
  .then(pretty => process.stdout.write(pretty))
  .catch(err => {
    console.error(`ppjl: formatting failed: ${err.message}`);
    process.exit(1);
  });
