#!/usr/bin/env node
'use strict';

const fs = require('fs');
const prettier = require('prettier');

// ── Parse JSONL files into a flat array ──────────────────────────
const args = process.argv.slice(2);

if (args.length === 0) {
  console.error('Usage: ppjl <file.jsonl...>');
  process.exit(1);
}

const records = [];
for (const path of args) {
  const text = fs.readFileSync(path, 'utf8');
  for (const line of text.split('\n')) {
    const trimmed = line.trim();
    if (trimmed.length === 0) continue;
    records.push(JSON.parse(trimmed));
  }
}

// ── Format the assembled JSON array ──────────────────────────────
const rawJson = JSON.stringify(records);
prettier.format(rawJson, { parser: 'json', printWidth: 100 }).then(pretty => process.stdout.write(pretty));
